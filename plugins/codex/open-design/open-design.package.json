{
  "schemaVersion": "open-design-codex-cloud-package/v3",
  "name": "open-design",
  "version": "0.5.3",
  "minimumCodexCliVersion": "0.144.6",
  "minimumOpenDesignVersion": "0.17.0",
  "telemetrySchemaVersion": 3,
  "defaultMode": "cloud",
  "mcpServer": "open-design",
  "localMcp": {
    "installCommand": "od mcp install codex",
    "packagedInstallArgs": [
      "--headless",
      "--mcp-install",
      "codex"
    ],
    "discovery": "/api/mcp/install-info",
    "headlessBootstrap": true,
    "capabilities": {
      "core": {
        "requiredTools": [
          "collect_brief",
          "confirm_brief",
          "get_active_context",
          "list_projects",
          "create_project",
          "start_run",
          "get_run"
        ]
      },
      "cloud": {
        "requiredTools": [
          "collect_brief",
          "confirm_brief",
          "get_active_context",
          "list_projects",
          "create_project",
          "start_run",
          "get_run",
          "get_vela_login_status",
          "start_vela_login",
          "list_agents"
        ]
      },
      "localCodex": {
        "requiredTools": [
          "collect_brief",
          "confirm_brief",
          "get_active_context",
          "list_projects",
          "create_project",
          "start_run",
          "get_run",
          "list_agents"
        ]
      },
      "byok": {
        "requiredTools": [
          "collect_brief",
          "confirm_brief",
          "get_active_context",
          "list_projects",
          "create_project",
          "start_run",
          "get_run",
          "list_byok_profiles"
        ]
      },
      "optional": {
        "tools": [
          "get_artifact"
        ],
        "requiredForDefaultDelivery": false,
        "capabilityCheck": "before-use"
      }
    },
    "pluginWorkflowContract": {
      "context": {
        "id": "open-design",
        "version": "0.5.3",
        "distributionMechanism": "git_marketplace",
        "publisherClass": "open_design_first_party"
      },
      "attributionQuality": "self_reported",
      "firstObservedTool": "collect_brief",
      "pluginWorkflowId": "server-issued-stable-per-workflow"
    },
    "requestContract": {
      "requestId": "stable-per-confirmed-action",
      "transportRetry": "reuse-identical-request",
      "rechargeResume": "reuse-identical-request-with-resume-true"
    }
  },
  "cloudRuntime": {
    "agent": "amr",
    "authentication": "vela-login",
    "apiUrl": "https://amr-api.open-design.ai",
    "linkUrl": "https://amr-link.open-design.ai"
  },
  "customUiResources": [
    {
      "uri": "ui://open-design/artifact-card-v5.html",
      "mediaType": "text/html;profile=mcp-app"
    }
  ],
  "optionalModes": {
    "localCli": {
      "status": "shared-local-mcp",
      "mcpServer": "open-design",
      "installCommand": "od mcp install codex",
      "discovery": "/api/mcp/install-info",
      "agent": "codex",
      "authentication": "codex-login",
      "loginCommand": "codex login",
      "requestId": "required",
      "settingsSource": {
        "preferred": "host-active-task-metadata",
        "fallback": "CODEX_THREAD_ID-latest-turn_context",
        "identifierHandling": "lookup-only-never-print-or-persist"
      },
      "startRunArguments": {
        "required": [
          "agent"
        ],
        "optional": [
          "model",
          "reasoning",
          "serviceTier"
        ]
      },
      "compatibility": "require-explicit-exact-or-stop-before-generation",
      "orchestration": "single-long-lived-start-poll-call",
      "transportRetry": "byte-identical-same-logical-run-on-lost-response-only"
    },
    "byok": {
      "status": "secure-profile",
      "mcpServer": "open-design",
      "setupCommand": "od byok save --api-key-stdin",
      "discovery": "/api/byok/profiles",
      "credentialReference": "non-secret-profile-id",
      "requestId": "required"
    }
  }
}
