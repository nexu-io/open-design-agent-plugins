{
  "schemaVersion": "open-design-codex-cloud-package/v2",
  "name": "open-design-cloud",
  "version": "0.2.0",
  "minimumCodexCliVersion": "0.144.6",
  "defaultMode": "cloud",
  "mcpServer": "open-design",
  "localMcp": {
    "installCommand": "od mcp install codex",
    "discovery": "/api/mcp/install-info"
  },
  "cloudRuntime": {
    "agent": "amr",
    "authentication": "vela-login",
    "apiUrl": "https://amr-api.open-design.ai",
    "linkUrl": "https://amr-link.open-design.ai"
  },
  "customUiResources": [
    {
      "uri": "ui://open-design-cloud/artifact-card-v1.html",
      "mediaType": "text/html;profile=mcp-app"
    }
  ],
  "optionalModes": {
    "localCli": {
      "status": "shared-local-mcp",
      "mcpServer": "open-design",
      "installCommand": "od mcp install codex",
      "discovery": "/api/mcp/install-info",
      "agent": "codex",
      "authentication": "codex-login",
      "loginCommand": "codex login"
    },
    "byok": {
      "status": "secure-profile",
      "mcpServer": "open-design",
      "setupCommand": "od byok save --api-key-stdin",
      "discovery": "/api/byok/profiles"
    }
  }
}
